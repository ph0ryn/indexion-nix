#!/usr/bin/env python3
import json
import os
import re
import subprocess
import urllib.request
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PACKAGE = ROOT / "package.nix"
ASSETS = {
    "aarch64-darwin": "indexion-darwin-arm64.tar.gz",
    "x86_64-linux": "indexion-linux-x64.tar.gz",
}


def latest_release():
    headers = {"Accept": "application/vnd.github+json"}
    if token := os.environ.get("GH_TOKEN"):
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(
        "https://api.github.com/repos/trkbt10/indexion/releases/latest", headers=headers
    )
    with urllib.request.urlopen(request) as response:
        return json.load(response)


def prefetch(url):
    result = subprocess.run(
        ["nix", "store", "prefetch-file", "--json", url],
        check=True,
        capture_output=True,
        text=True,
    )
    return json.loads(result.stdout)["hash"]


release = latest_release()
version = release["tag_name"].removeprefix("v")
urls = {asset["name"]: asset["browser_download_url"] for asset in release["assets"]}
hashes = {system: prefetch(urls[name]) for system, name in ASSETS.items()}

contents = PACKAGE.read_text()
contents, count = re.subn(r'version = "[^"]+";', f'version = "{version}";', contents, count=1)
if count != 1:
    raise RuntimeError("could not update version")

for system, name in ASSETS.items():
    pattern = rf'({system} = \{{\n\s+archive = "{re.escape(name)}";\n\s+hash = ")[^"]+(";)'
    contents, count = re.subn(pattern, rf'\g<1>{hashes[system]}\g<2>', contents, count=1)
    if count != 1:
        raise RuntimeError(f"could not update {system} hash")

PACKAGE.write_text(contents)
